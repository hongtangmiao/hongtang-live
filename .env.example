# hongtang-live 首次启动环境变量示例
# 用法：复制为仓库根目录下的 .env（已加入 .gitignore，不会提交进 git）。
# 注意：.env 仅在第一次启动（data/config.json 尚不存在）时导入；
#       之后所有配置以设置页（/admin）和 data/config.json 为准。
#
# ⚠️ 安全提醒：
#   公网部署务必通过 HTTPS 反向代理（Nginx / Caddy / Cloudflare Tunnel 等）暴露服务，
#   切勿直接将 8090 / 8088 暴露在公网 HTTP，否则 /admin 管理员密码与设备上报的 Bearer Token
#   会以明文传输！

# ---- 站点与时区 ----
SITE_TITLE=My Live Status
SITE_DOMAIN=example.com
TZ=Asia/Shanghai

# ---- 网易云音乐（NeteaseCloudMusicApi）----
NE_API=https://netease-api.example.com
NE_REFRESH_HOURS=12
# BIND_KEY=可选，用于非管理员态重绑网易云账号

# ---- 番剧墙（Bangumi + Jellyfin，均可选）----
BGM_USER=
# BGM_TOKEN=可选，显示私密收藏时需要（https://next.bgm.tv/demo/access-token）
JF_URL=http://host.docker.internal:8096
# 也可以拆开写 JF_HOST / JF_PORT（当 JF_URL 为空时生效）
# JF_HOST=host.docker.internal
# JF_PORT=8096
JF_USER=
JF_KEY=

# ---- Daylog 数据与 AI 日报 ----
DAYLOG_DB=/daylog/data/app.db
DAYLOG_ROOT=/daylog
DAYLOG_CONFIG=/daylog/config.json
# DAYLOG_WRITER=true（首次启动默认开启写库与定时任务；仅在和旧版 Python daylog 共用库时设为 false）
# DEEPSEEK_API_KEY=可选，优先于设置页里的 DeepSeek API Key

# ---- 系统资源监控（宿主挂载与显示名）----
HOST_PROC=/host/proc
HOST_ROOT=/host/root
ROOT_DISK=/data
STATS_PC_NAME=My PC
STATS_SERVER_ID=server
STATS_SERVER_NAME=My Server

# ---- 构建 / 测试镜像源覆盖（默认走官方源，国内环境可取消注释加速）----
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com
